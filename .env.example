# ==========================================
# Backend Configuration
# ==========================================

# Comma-separated pool of at least 2 API keys (mapped sequentially to key_1, key_2, ...)
# For Google Gemini: AIzaSy...,AIzaSy...
# For Groq: gsk_...,gsk_...
# For OpenAI: sk-proj-...,sk-proj-...
LLM_API_KEYS=key_1_placeholder,key_2_placeholder

# Database location for SQLite storage (under /data volume in Docker)
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (comma-separated list of origins permitted to access backend)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook via X-Simulate-Failure header (true or false)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM Model name
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Default System Prompt for the LLM session
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Cache Type: "local" (in-memory) or "disk" (persistent disk cache)
CACHE_TYPE=local

# ==========================================
# Frontend Configuration
# ==========================================

# URL pointing to the deployed/running backend API
VITE_BACKEND_URL=http://localhost:8000
